rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid} {
   function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
   allow read: if owner();
   allow create, update: if owner()
    && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
    && request.resource.data.keys().hasAll(['language', 'favorites', 'updatedAt'])
    && request.resource.data.keys().hasOnly(['language', 'favorites', 'updatedAt'])
    && request.resource.data.language in ['el', 'en']
    && request.resource.data.favorites is list
    && request.resource.data.favorites.size() <= 200
    && request.resource.data.favorites.toSet().size() == request.resource.data.favorites.size()
    && request.resource.data.updatedAt == request.time;
   allow delete: if owner();
  }
  // This minimal marker prevents stale sessions from recreating erased preferences.
  match /accountDeletions/{uid} {
   function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
   allow get: if owner();
   allow create: if owner() && request.resource.data.keys().hasOnly(['deletedAt']) && request.resource.data.deletedAt == request.time;
   // A recent sign-in can roll back a deletion whose Auth step failed.
   allow delete: if owner() && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300;
  }
  function imageSize(images, n) { return images.size() > n ? images[n].size() : 0; }
  function imageValid(images, n) { return images.size() <= n || (images[n] is string && images[n].matches('data:image/jpeg;base64,[A-Za-z0-9+/]+=*')); }
  match /feedback/{ticket} {
   allow create: if request.resource.data.keys().hasOnly(['text','images','name','email','uid','ticket','page','url','ua','forwarded','status','createdAt'])
    && ticket.matches('OASA-[0-9]{6}-[A-F0-9]{12}')
    && request.resource.data.ticket == ticket
    && request.resource.data.text is string && request.resource.data.text.size() > 12 && request.resource.data.text.size() <= 18012
    && request.resource.data.images is list && request.resource.data.images.size() <= 3
    && imageValid(request.resource.data.images, 0) && imageValid(request.resource.data.images, 1) && imageValid(request.resource.data.images, 2)
    && imageSize(request.resource.data.images, 0) + imageSize(request.resource.data.images, 1) + imageSize(request.resource.data.images, 2) <= 716800
    && request.resource.data.name is string && request.resource.data.name.size() <= 200
    && request.resource.data.email is string && request.resource.data.email.size() <= 200
    && request.resource.data.url is string && request.resource.data.url.size() <= 2000
    && request.resource.data.page == 'oasa-live-feedback'
    && request.resource.data.uid == null && request.resource.data.ua == ''
    && request.resource.data.forwarded == false && request.resource.data.status == 'new'
    && request.resource.data.createdAt == request.time;
   allow read, update, delete: if false;
  }
 }
}
